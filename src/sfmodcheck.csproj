<Project Sdk="Microsoft.NET.Sdk">

  <!-- sfmodcheck (StarfieldPluginCheck until 0.3.0): read-only checks of a built Starfield plugin (replaces "xDump -check" in our build gates).
       Built on BuildKit, so it uses the same official Mutagen 0.54.4 pin as the builders.

       BuildKit comes from nuget.org (Taosecurity.Starfield.BuildKit, exact version). The author's private working copy
       has a Directory.Build.props that sets UseBuildKitPackage=false, which uses the local ..\..\tools\BuildKit project
       instead. Each way has its own lock file, so neither changes the other:
         packages.lock.json                    project reference (author's copy only)
         packages.public.lock.json             nuget.org package
         packages.public.win-x64.lock.json     nuget.org package, stand-alone exe (dotnet publish -r win-x64)
       Builds:
         dotnet build src -c Release                                         the exe in bin\Release\net9.0
         dotnet pack src -c Release -p:SfModCheckPack=true -o out            the dotnet tool package (sf-mod-check.<v>.nupkg)
         dotnet publish src -c Release -r win-x64 -p:SfModCheckStandalone=true -o out\exe   one sf-mod-check.exe, no .NET needed -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SfModCheck</RootNamespace>
    <AssemblyName>sf-mod-check</AssemblyName>
    <Version>0.16.2</Version>
    <!-- Shown in the exe's file properties (Details tab); attribution added 2026-11-11. -->
    <Product>sf-mod-check</Product>
    <AssemblyTitle>sf-mod-check: read-only checks of Starfield mods</AssemblyTitle>
    <Company>Richard Bejtlich</Company>
    <Copyright>Copyright (C) 2026 Richard Bejtlich. GPL-3.0.</Copyright>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Build data\scene-alias-quirks.txt into the exe (private build only: it names official FormIDs and EditorIDs).
         The public repo doesn't have the file, so its build relies on the list learned from the user's own Data
         folder (LearnedCache.cs). -->
    <EmbedSceneQuirks Condition="'$(EmbedSceneQuirks)' == ''">true</EmbedSceneQuirks>
    <BuildKitProject>$(MSBuildThisFileDirectory)..\..\tools\BuildKit\BuildKit.csproj</BuildKitProject>
    <UseBuildKitPackage Condition="'$(UseBuildKitPackage)' == ''">true</UseBuildKitPackage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseBuildKitPackage)' == 'true'">
    <NuGetLockFilePath>packages.public.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' != ''">packages.public.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <!-- The dotnet tool package (dotnet tool install -g sf-mod-check - -add-source <folder>), only when packing. -->
  <PropertyGroup Condition="'$(SfModCheckPack)' == 'true'">
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sf-mod-check</ToolCommandName>
    <!-- run on .NET 10 and later too, when .NET 9 isn't installed -->
    <RollForward>Major</RollForward>
    <PackageId>sf-mod-check</PackageId>
    <Authors>Richard Bejtlich</Authors>
    <Description>Read-only, offline checks of Starfield mods: plugin checks (structure, FormIDs, links, conditions, scenes, deleted and identical-to-master records), whole load-order conflicts, release-zip checks, and triage: a first-pass report on a downloaded mod. Formerly sfmodcheck.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/taosecurity/sf-mod-check</PackageProjectUrl>
    <RepositoryUrl>https://github.com/taosecurity/sf-mod-check</RepositoryUrl>
    <PackageTags>starfield;mods;plugins;esm;mutagen;xedit;creation-kit;triage;sfse</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(SfModCheckPack)' == 'true'">
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\AGENTS.md" Pack="true" PackagePath="\" Condition="Exists('..\AGENTS.md')" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" Condition="Exists('..\LICENSE')" />
    <None Include="..\NOTICE" Pack="true" PackagePath="\" Condition="Exists('..\NOTICE')" />
  </ItemGroup>

  <!-- The stand-alone exe: one file with .NET inside, for authors without the .NET SDK. No trimming (Mutagen uses reflection). -->
  <PropertyGroup Condition="'$(SfModCheckStandalone)' == 'true'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\data\engine-forms.txt" LogicalName="engine-forms.txt" />
    <EmbeddedResource Include="..\data\link-types-seen.txt" LogicalName="link-types-seen.txt" Condition="Exists('..\data\link-types-seen.txt')" />
    <EmbeddedResource Include="..\data\condition-params-seen.txt" LogicalName="condition-params-seen.txt" Condition="Exists('..\data\condition-params-seen.txt')" />
    <EmbeddedResource Include="..\data\condition-functions-seen.txt" LogicalName="condition-functions-seen.txt" Condition="Exists('..\data\condition-functions-seen.txt')" />
    <EmbeddedResource Include="..\data\required-fields-seen.txt" LogicalName="required-fields-seen.txt" Condition="Exists('..\data\required-fields-seen.txt')" />
    <EmbeddedResource Include="..\data\creations-masters.txt" LogicalName="creations-masters.txt" />
    <EmbeddedResource Include="..\data\field-priorities.txt" LogicalName="field-priorities.txt" />
    <EmbeddedResource Include="..\data\scene-alias-quirks.txt" LogicalName="scene-alias-quirks.txt" Condition="'$(EmbedSceneQuirks)' != 'false' And Exists('..\data\scene-alias-quirks.txt')" />
  </ItemGroup>

  <!-- Tests only: lets the test project reach internal test hooks such as Assets.AfterIndex. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SfModCheck.Tests" />
  </ItemGroup>

  <!-- triage reads .7z and .rar downloads (0.8.0). SharpCompress is MIT; exact pin, 0.50.7 released 2026-10-20. -->
  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="[0.50.7]" />
    <!-- the Scripts section unpacks LZ4 entries of .ba2 archives itself (0.9.1). K4os.Compression.LZ4 is MIT; exact pin at
         1.3.8, the version Mutagen already brought in, so the build no longer depends on what another package pulls in. -->
    <PackageReference Include="K4os.Compression.LZ4" Version="[1.3.8]" />
  </ItemGroup>

  <!-- Mutagen.Bethesda.Starfield 0.54.4 comes through BuildKit (exact pin, never the local taosecurity package). -->
  <ItemGroup Condition="'$(UseBuildKitPackage)' != 'true'">
    <ProjectReference Include="$(BuildKitProject)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseBuildKitPackage)' == 'true'">
    <PackageReference Include="Taosecurity.Starfield.BuildKit" Version="[0.3.1]" />
  </ItemGroup>

</Project>
